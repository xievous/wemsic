# ---------------------------------------------------------------------------
# Local development (.env at repo root). For production, set these in the
# host's dashboard instead (Vercel for the web app, Railway/Render/Fly for
# the API). See the "Deploy" section in README.md.
# ---------------------------------------------------------------------------

# API server (apps/api)
PORT=3001
# Comma-separated browser origins allowed for CORS + Socket.io.
# In dev, localhost:5173 is allowed automatically.
# In production set this to your web URL, e.g. https://wemsic.vercel.app
WEB_ORIGIN=http://127.0.0.1:5173
# Public URL of the API itself, e.g. https://wemsic-api.onrender.com
API_PUBLIC_URL=http://127.0.0.1:3001

# Spotify (https://developer.spotify.com/dashboard)
# Redirect URI must use 127.0.0.1 — Spotify does NOT allow "localhost"
# Add this exact URI in Dashboard → Your app → Settings → Redirect URIs.
# In production it must be: <API_PUBLIC_URL>/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/auth/spotify/callback

# Web app (apps/web, Vite) — open http://127.0.0.1:5173 in the browser.
# This is baked in at BUILD time. On Vercel, set VITE_API_URL to your
# deployed API URL (e.g. https://wemsic-api.onrender.com).
VITE_API_URL=http://127.0.0.1:3001
