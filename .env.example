# API server
PORT=3001
# Comma-separated if needed. In dev, localhost:5173 is allowed automatically.
WEB_ORIGIN=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:3001

# Spotify (https://developer.spotify.com/dashboard)
# Redirect URI must use 127.0.0.1 — Spotify does NOT allow "localhost"
# Add this exact URI in Dashboard → Your app → Settings → Redirect URIs:
#   http://127.0.0.1:3001/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/auth/spotify/callback

# Web app (Vite) — open http://127.0.0.1:5173 in the browser
VITE_API_URL=http://127.0.0.1:3001
